# CouchDB Configuration for Obsidian LiveSync
# Copy this file to .env and modify the values as needed

# CouchDB Admin User
COUCHDB_USER=admin

# CouchDB Admin Password (change this to a secure password)
COUCHDB_PASSWORD=password

# CouchDB Secret Key (change this to a secure random string)
COUCHDB_SECRET=mysecret

# CouchDB Node Name
NODENAME=couchdb@127.0.0.1

# Database Configuration
DB_NAME=obsidian-livesync

# Optional: CORS settings for web access
CORS_ENABLED=true

# Directory for LiveSync data (used by Portainer)
# Set this to the absolute path where you want to store the data
LIVESYNC_DIR=/opt/obsidian-livesync



